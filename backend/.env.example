APP_NAME=AIProf Healthcare Platform
ENVIRONMENT=production

# SQLite for zero-config Render deployment:
DATABASE_URL=sqlite:///./aiprof_healthcare.db

# Or Render Managed PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@dpg-xxx-a.render.com/aiprof_db

JWT_SECRET_KEY=super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Render Redis Internal URL or default:
REDIS_URL=redis://localhost:6379/0

GOOGLE_API_KEY=your-google-gemini-api-key